# Salin ke .env.local lalu isi. Berkas ini hanya berisi NAMA variabel — jangan
# pernah menaruh nilai sungguhan di sini. Variabel kosong = fiturnya mati dengan
# sendirinya, bukan error.

# ── Basis data (Neon Postgres) ───────────────────────────────────────────────
DATABASE_URL=            # URL pooled, dipakai aplikasi
DIRECT_URL=              # URL langsung (non-pooled), dipakai drizzle-kit migrate

# ── Cache, kuota, telemetry (Upstash Redis) ──────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Antrean job (Upstash QStash) & cron ──────────────────────────────────────
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
CRON_SECRET=             # sama dengan secret repo GitHub untuk workflow dispatcher

# ── Situs ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=     # mis. https://domain-anda.com
VISITOR_HASH_SALT=       # string acak untuk hash pengunjung analytics
IP_GEO_FALLBACK=

# ── Sesi & admin ─────────────────────────────────────────────────────────────
SESSION_SECRET=          # string acak panjang; tanpa ini jatuh ke ADMIN_SECRET_KEY
ADMIN_SECRET_KEY=        # PIN/rahasia masuk admin (alias lama: ADMIN_PIN)
ADMIN_LOGIN_SLUG=        # path rahasia halaman login admin, opsional
ADMIN_TOKEN=             # bearer token untuk endpoint admin/job dari skrip

# ── Model bahasa ─────────────────────────────────────────────────────────────
# Tiap *_API_KEY bisa dirotasi: tambahkan *_API_KEY_2, *_API_KEY_3, dst.
OPENAI_API_KEY=
OPENAI_MODEL=
CLOUDFLARE_API_TOKEN=    # butuh izin Workers AI, bukan token DNS
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MODELS=       # daftar dipisah koma, opsional
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
CEREBRAS_BASE_URL=
CEREBRAS_REASONING_EFFORT=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
PREMIUM_LLM_BASE_URL=
PREMIUM_LLM_MODEL=
# Preferensi provider per peran komite (opsional)
KETUA_LLM_PROVIDER=
RISIKO_LLM_PROVIDER=
STRATEG_LLM_PROVIDER=
# Pagu harian panggilan model (opsional, ada bawaan)
LLM_DAILY_CEILING=
LLM_DAILY_PER_USER=
LLM_DAILY_PER_ANON=

# ── Pembayaran (Tripay) ──────────────────────────────────────────────────────
TRIPAY_MODE=sandbox      # ganti ke "production" hanya setelah uji sandbox
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=

# ── Login Google (Firebase) ──────────────────────────────────────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Penyimpanan berkas (Supabase Storage) ────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── Anti-bot (Cloudflare Turnstile) ──────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics & iklan ────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=                      # G-XXXXXXXXXX
GA4_PROPERTY_ID=                        # angka properti, bukan "G-..."
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
NEXT_PUBLIC_ADSENSE_CLIENT=

# ── Sumber data & media ──────────────────────────────────────────────────────
SEC_CONTACT_EMAIL=       # wajib untuk SEC EDGAR (fundamental saham AS)
SEC_USER_AGENT=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
YOUTUBE_API_KEY=
