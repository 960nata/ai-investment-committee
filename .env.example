# --- SUPABASE STORAGE ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="ai investasi"

# --- SUMBER FOTO SAMPUL WARTA (opsional) ---
# Tanpa kunci pun pencarian foto tetap jalan lewat Openverse dan Wikimedia
# Commons yang terbuka. Mengisi salah satu kunci di bawah hanya menaikkan mutu
# editorial hasil pencarian, dan sumber berkunci akan dicoba lebih dulu.
PEXELS_API_KEY=""
UNSPLASH_ACCESS_KEY=""

# Surel kontak untuk header User-Agent ke SEC EDGAR. Wajib diisi; SEC menolak
# permintaan tanpa identitas yang bisa dihubungi.
SEC_CONTACT_EMAIL=""

# --- SESI PENGGUNA ---
# Kunci penanda tangan cookie sesi. Wajib diisi di produksi; tanpa ini sesi
# ditandatangani kunci cadangan yang tertulis di dalam kode, dan siapa pun yang
# membaca repositori bisa memalsukannya.
#   openssl rand -base64 32
SESSION_SECRET=""

# PIN / kunci portal administrator. Kalau kosong, nilai cadangannya
# "komite-admin-2026" — jangan dibiarkan begitu di produksi.
ADMIN_SECRET_KEY=""

# --- GOOGLE ANALYTICS 4 ---
# Dua bagian yang bisa diisi terpisah.
#
# 1) Tag pengukuran untuk gtag.js di peramban. Tanpa ini tidak ada satu pun
#    kunjungan yang tercatat, dan halaman /admin/analytics selamanya kosong.
NEXT_PUBLIC_GA_ID=""
#
# 2) Kredensial Data API supaya angkanya bisa dibaca balik ke /admin/analytics.
#    Semuanya dari satu service account Google Cloud yang sudah ditambahkan
#    sebagai Viewer di properti GA4 (Admin -> Property access management).
#
#    GA4_PROPERTY_ID adalah NOMOR properti (Admin -> Property details), bukan
#    id pengukuran yang diawali "G-".
GA4_PROPERTY_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
#    Salin utuh dari berkas JSON, termasuk header/footer PEM. Baris barunya
#    ditulis sebagai \n harfiah; kode yang membacanya sudah memulihkannya.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# --- ANALITIK KUNJUNGAN ---
# Garam untuk sidik pengunjung. Alamat IP tidak pernah disimpan; yang tersimpan
# adalah HMAC dari IP + agen peramban, dan garam inilah yang membuatnya tidak
# bisa dibalik dengan menebak satu per satu seluruh ruang alamat IPv4.
#   openssl rand -base64 32
VISITOR_HASH_SALT=""

# Isi "0" untuk melarang penelusuran lokasi ke layanan luar sama sekali. Di
# Vercel jalur ini memang tidak pernah dipakai: lokasinya sudah datang dari
# header tepi jaringan.
IP_GEO_FALLBACK="1"

# --- PENYARING SERANGAN & PAGU MODEL ---
# Upstash Redis. Tanpa ini tiga lapisan sekaligus turun kelas, dan turunnya
# tidak menimbulkan galat apa pun — persis jenis kerusakan yang paling lama
# tidak ketahuan:
#
#   - Pembatas laju API mati total (gagal terbuka). Kuota di lib/http/ratelimit.ts
#     tidak berlaku sama sekali.
#   - Blokir penyerang hanya berlaku selama instance yang melayani masih hidup,
#     dan pelanggar berulang tidak dikenali sebagai pengulang.
#   - Halaman /admin/keamanan tidak punya insiden untuk ditampilkan.
#   - Pagu belanja model turun ke penghitung memori dengan pagu seperempatnya.
#
# Paket gratis Upstash sudah cukup. Ambil keduanya dari Upstash Console ->
# pilih database -> REST API.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Berapa rapat komite yang boleh dijalankan seluruh pemanggil dalam sehari.
# Angka ini, bukan jumlah kunci, yang menentukan apakah kuota gratisan masih
# hidup besok pagi: sepuluh alamat berbeda yang masing-masing patuh pada kuota
# per-alamat tetap bisa menghabiskan seluruhnya sebelum tengah hari.
#
# Enam puluh persennya jatah lalu lintas publik; sisanya disimpan untuk rapat
# harian terjadwal, supaya pekerjaan yang jadi alasan proyek ini ada tidak
# pernah kalah oleh pengunjung yang kebetulan ramai di pagi yang sama.
LLM_DAILY_CEILING="300"

# Jatah satu akun per hari, supaya satu orang tidak menghabiskan jatah publik
# sendirian.
LLM_DAILY_PER_USER="15"
