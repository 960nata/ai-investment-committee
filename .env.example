# ---------------------------------------------------------------------------
# Database — Supabase, Project Settings > Database > Connection string
# ---------------------------------------------------------------------------
# Pooler (Transaction, port 6543) dipakai runtime aplikasi.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Direct (port 5432) dipakai drizzle-kit untuk migrasi; pgBouncer tidak bisa DDL.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Antrian job — Upstash QStash
# ---------------------------------------------------------------------------
# Tanpa ini worker dipanggil langsung tanpa retry. Cukup untuk mesin lokal,
# tidak cukup untuk produksi: job yang gagal hilang begitu saja.
QSTASH_TOKEN=""
# Kunci penandatanganan memverifikasi bahwa panggilan ke /api/jobs/* memang dari
# QStash. Di produksi, tanpa keduanya semua permintaan worker ditolak.
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# ---------------------------------------------------------------------------
# Cache — Upstash Redis (REST, bukan koneksi TCP)
# ---------------------------------------------------------------------------
# Opsional untuk cache respons API, tetapi penting begitu komite agen dipakai:
# keyring menyimpan pendinginan kunci dan kursor giliran di sini. Tanpa Redis
# keduanya hanya hidup di memori satu invocation, dan di produksi itu berarti
# kunci yang kena limit dicoba lagi jauh lebih cepat dari seharusnya.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Lain-lain
# ---------------------------------------------------------------------------
# Rahasia yang memverifikasi tiap panggilan ke /api/cron/dispatcher.
# Vercel mengirimnya otomatis sebagai header Authorization: Bearer <CRON_SECRET>.
CRON_SECRET="ganti-dengan-string-acak-panjang"

# URL aplikasi, dipakai dispatcher saat mengantre pekerjaan ke worker-nya sendiri.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Penyedia LLM — komite agen (lib/ai/registry.ts)
# ---------------------------------------------------------------------------
# Cukup isi SATU penyedia. Sisanya jadi cadangan: registry turun ke penyedia
# berikutnya saat yang di atasnya kena limit atau mati.
#
# Tiap penyedia boleh punya banyak kunci, dinomori PREFIX, PREFIX_2, PREFIX_3,
# dan seterusnya. Keyring memutarnya bergilir dan mengistirahatkan kunci yang
# kena 429, jadi sepuluh kunci benar-benar memberi sepuluh kali kuota. Nomor
# yang bolong dilewati, bukan menghentikan pemindaian.
#
# Jangan pernah memberi kunci ini awalan NEXT_PUBLIC_ — variabel berawalan itu
# ikut terkirim ke browser.
GEMINI_API_KEY=""
# GEMINI_API_KEY_2=""
GEMINI_MODEL="gemini-2.0-flash"

GROQ_API_KEY=""
# GROQ_API_KEY_2=""
GROQ_MODEL="llama-3.3-70b-versatile"

OPENROUTER_API_KEY=""
# OPENROUTER_API_KEY_2=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
