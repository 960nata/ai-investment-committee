# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Berkas konfigurasi lingkungan & kredensial — DILARANG KERAS di-commit/push.
.env
.env*
.env.*
*.env

# Kecuali berkas contohnya, yang isinya hanya nama variabel dan penjelasannya —
# tidak satu pun nilai sungguhan. Tanpa pengecualian ini, tiap variabel baru
# hanya terdokumentasi di mesin orang yang menambahkannya, dan pemasangan
# berikutnya menemukannya lewat fitur yang diam-diam tidak bekerja.
!.env.example

# Kunci, sertifikat, dan berkas kredensial lain
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# vercel
.vercel

# drizzle — migrasi SQL justru WAJIB ikut commit; ia riwayat perubahan skema
# dan satu-satunya cara menerapkan skema yang sama di mesin lain.

# typescript
*.tsbuildinfo
next-env.d.ts

# file instruksi agen lokal, tidak ikut repo
CLAUDE.md
.claude
*claude*

# temporary screenshots / audit dumps
/*.png

